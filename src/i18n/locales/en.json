  "talk.ghaw.markdown.title": "GitHub Agentic Workflows\nin 5 minutes.",
  "talk.ghaw.markdown.body": "A workflow is a Markdown file: settings on top, the prompt below. GitHub supplies the actions and the setup.",
  "talk.ghaw.markdown.command": "cat .github/workflows/implement-issue.md",
  "talk.ghaw.flow.title": "From Issue to PR\nwith one API key.",
  "talk.ghaw.flow.body": "You compile the Markdown into an Actions workflow. The agent reads with no write access and proposes. gh-aw checks the proposal and opens the PR.",
  "talk.ghaw.flow.command": "gh aw compile",
  "talk.ghaw.months.title": "Understanding it takes 5 minutes.\nGetting it right takes months.",
  "talk.ghaw.months.body": "The demo works on day one. Running it on real repos took us months: conventions, an agent environment, routes with gates, runners and measurement.",
  "talk.ghaw.months.command": "the hard part",
  "talk.local.title": "At the start,\nwe worked with AI\nsynchronously.",
  "talk.local.body": "You supply context, review the change and give the next instruction.",
  "talk.local.command": "interactive work",
  "talk.maturity.levels.title": "Different levels\nof maturity.",
  "talk.maturity.levels.body": "Different teams and companies are at different points in adopting AI across the software development lifecycle.",
  "talk.maturity.levels.command": "AI SDLC assessment",
  "talk.evolution.timeline.title": "The evolution of AI.",
  "talk.evolution.timeline.command": "models → prompts → skills → agents → loops",
  "talk.platform.chapter.title": "How we built the Platform",
  "talk.platform.chapter.command": "How we built the Platform",
  "talk.platform.pillars.title": "The 4 pillars\nof Platform.",
  "talk.platform.pillars.command": "Plain Concepts Platform",
  "talk.foundations.conventions.title": "Foundations:\ntechnology conventions.",
  "talk.foundations.conventions.body": "A thin base for many apps: a .NET backend, a Next.js frontend and one shared brand. People and agents follow the same rules.",
  "talk.foundations.conventions.command": "Foundations · backend · frontend · branding",
  "talk.harness.conventions.title": "agent-harness:\nagentic conventions.",
  "talk.harness.conventions.body": "One command installs it in each repo: OpenSpec for changes, plugins that block unsafe actions, the skills each project needs, and guardrails.",
  "talk.harness.conventions.command": "npx @plainconceptsplatform/agent-harness",
  "talk.workflows.intro.title": "agentic-workflows: asynchronous\ndevelopment in the cloud.",
  "talk.workflows.intro.body": "Our layer on top of GitHub Agentic Workflows: one router, workers that use the agent-harness skills, OpenCode through Forge, and writes only through Safe Outputs.",
  "talk.workflows.intro.command": "npx @plainconceptsplatform/workflows",
  "talk.workflows.router.title": "One router for every event.",
  "talk.workflows.router.body": "One event, one run, at most one worker. Classification is pure shell with no network calls. An idle run costs about ten seconds.",
  "talk.workflows.router.command": "gh aw compile → work-router.lock.yml",
  "talk.workflows.hybrid.title": "Jobs → agent → jobs\n→ Safe Outputs",
  "talk.workflows.hybrid.body": "Jobs collect facts. OpenCode decides through Forge, our AI gateway, with read-only access. Validators check the result. Safe Outputs applies allowed writes.",
  "talk.workflows.hybrid.command": "OpenCode → Forge → model · Safe Outputs",
  "talk.workflows.triage.title": "Triage: the front door.",
  "talk.workflows.triage.body": "Four outcomes: pass, needs info, needs a maintainer, block. Three rounds at most. In round three, needs info is no longer allowed.",
  "talk.workflows.triage.command": "agent-triage.md",
  "talk.workflows.refine.title": "Refine: size and split the work.",
  "talk.workflows.refine.body": "Explore the code one unit at a time. Write the story as Given, When, Then. Estimate in Fibonacci. Eight or more splits into 2 to 6 children.",
  "talk.workflows.refine.command": "agent-refine.md",
  "talk.workflows.implement.title": "Implement: one PR, then stop.",
  "talk.workflows.implement.body": "Eligible? Reserve, collect facts. Trivial marker takes the direct path, the rest runs plan-goal. Verify the scoped files. One PR. The gate decides.",
  "talk.workflows.implement.command": "agent-implement.md",
  "talk.workflows.gate.title": "Merge Gate: the only one that merges.",
  "talk.workflows.gate.body": "CI red? Repair, push, CI again. CI green? Measure the blast radius, the agent hunts defects, shell computes the verdict: merge, human, owner or blocked.",
  "talk.workflows.gate.command": "agent-merge-gate.md",
  "talk.workflows.others.title": "And four more workers.",
  "talk.workflows.others.body": "Apply Review applies review comments on bot PRs. Audit reads the repo weekly and files one Issue. Release writes the notes. Visual Verify takes screenshots after an auto-merge.",
  "talk.workflows.others.command": "agent-apply-review · agent-audit · agent-release · agent-visual-verify",
  "talk.health.portfolio.title": "One dashboard for every project.",
  "talk.health.portfolio.body": "Three of five DORA metrics, from GitHub alone. Change fail rate and recovery time need incident data GitHub lacks, so they stay empty.",
  "talk.health.portfolio.command": "project-health · DORA · agents",
  "talk.system.title": "From Issue to production\nwith GitHub Agentic Workflows.",
  "talk.system.body": "Product experts who do not code file small eligible Issues or bugs. They reach production without human supervision.",
  "talk.system.command": "Maintenance · Issue → production → Health",
  "talk.closing.question.title": "What exactly are software engineers supposed to do?",
  "talk.closing.question.command": "what do engineers do?"
}
